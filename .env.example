# ---------------------------------------------------------------------------
# ReferFlow environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://referflow:referflow_dev@localhost:5433/referflow?schema=public"

# Secret used to sign/derive values handed to browsers. Minimum 32 characters.
# Generate a fresh one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Public origin of the app, no trailing slash. Referral links are built from this.
APP_URL="http://localhost:3000"

# Days a referral click stays attributable to the referrer.
REFERRAL_ATTRIBUTION_DAYS="30"

# Reward paid to the referrer when a referral qualifies, in whole rupees.
REFERRAL_REWARD_AMOUNT="500"

# ISO 4217 currency code. V1 supports INR only.
REFERRAL_REWARD_CURRENCY="INR"
